# Copiá este archivo a ".dev.vars" (queda fuera de Git, nunca se sube) y
# pegá ahí tus valores reales para probar en tu computadora con
# `npx wrangler pages dev .`. En Cloudflare estas mismas variables se cargan
# en el proyecto → Settings → Environment variables, no acá.

# Access Token de Mercado Pago (el que empieza con TEST- para pruebas,
# APP_USR- cuando ya sea de verdad). Se copia desde
# mercadopago.com.ar/developers/panel → tu aplicación → Credenciales.
# ¡Nunca el mismo valor en TEST y en producción!
MP_ACCESS_TOKEN=

# Opcional pero recomendado: la "Clave secreta" que Mercado Pago muestra al
# configurar el webhook (Tu aplicación → Webhooks → Configurar notificaciones).
# Si se deja vacío, el webhook igual funciona (valida el pago llamando
# directo a la API de Mercado Pago), pero no puede confirmar que la
# notificación vino realmente de Mercado Pago antes de mirarla.
MP_WEBHOOK_SECRET=

# Connection string de la base Postgres en Neon (neon.tech). Ahí viven TODAS
# las reservas y las noches ocupadas: las que entran por la web, las que se
# cargan a mano desde el panel y los bloqueos por uso propio.
DATABASE_URL=

# Contraseña para entrar al panel de administración (/admin), donde se
# gestionan las reservas. Que sea larga y al azar, y guardala en un gestor de
# contraseñas: con ella se cancelan reservas y se ven los datos de los
# huéspedes. Sin esto cargado el panel no abre — falla cerrado.
# Cambiarla cierra todas las sesiones que estuvieran abiertas.
ADMIN_PASSWORD=

# Dominio público del bucket de R2 donde se suben las fotos nuevas desde el
# panel (ver lib/fotos.js). Se consigue conectando un dominio al bucket:
# Cloudflare → R2 → el bucket → Settings → Public access → Custom domain (o,
# para probar rápido, el subdominio r2.dev que ofrece la misma pantalla).
# Sin esto la galería se puede reordenar y editar, pero no se pueden subir
# fotos nuevas.
FOTOS_PUBLIC_URL=

# El bucket de R2 en sí NO se carga acá: es un binding (ver wrangler.toml,
# binding "FOTOS_BUCKET"), no una variable de texto. Para probar en local con
# `wrangler pages dev` alcanza con lo que ya declara wrangler.toml; en
# producción se conecta desde el dashboard del proyecto (Settings →
# Functions → R2 bucket bindings).
